{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tests-green-before-commit.sh",
            "timeout": 180
          }
        ]
      },
      {
        "matcher": "mcp__gcs__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gcs-allowlist.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
